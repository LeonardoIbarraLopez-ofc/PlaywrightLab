{
  "name": "laboratorio-playwright-claude-desarrollo-simple",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación simple y pruebas con Playwright + Claude en VS Code",
  "scripts": {
    "serve": "npx http-server app -p 3000",
    "test": "playwright test",
